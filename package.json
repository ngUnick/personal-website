{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev --workspace=@personal-website/api",
    "api:build": "npm run build --workspace=@personal-website/api",
    "api:test": "npm run test --workspace=@personal-website/api",
    "web:dev": "npm run start --workspace=@personal-website/web",
    "web:build": "npm run build --workspace=@personal-website/web",
    "web:test": "npm run test --workspace=@personal-website/web",
    "test": "npm run api:test && npm run web:test",
    "build": "npm run api:build && npm run web:build"
  }
}
